# Server Config
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mt5_analyzer?schema=public"

# Redis Configuration (Cache / Session)
REDIS_URL="redis://localhost:6379"

# Security Configurations
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="8h"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-in-production"
JWT_REFRESH_EXPIRATION="7d"

# AES Encryption Key for MT5 Credentials (32 bytes hex)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# AI Config
OPENAI_API_KEY="your-openai-api-key"
