{
  "name": "mt5-journal-analyzer",
  "version": "1.0.0",
  "description": "Enterprise-grade MT5 AI Journal Analyzer SaaS Platform",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "backend:dev": "npm run start:dev -w backend",
    "backend:build": "npm run build -w backend",
    "frontend:dev": "npm run dev -w frontend",
    "frontend:build": "npm run build -w frontend",
    "connector:dev": "cd mt5-connector && .venv\\Scripts\\python.exe -m uvicorn main:app --host 127.0.0.1 --port 4500",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:studio": "prisma studio --schema=prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "typescript": "^5.6.3"
  }
}
